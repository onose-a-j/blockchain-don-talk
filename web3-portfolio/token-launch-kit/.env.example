# Copy to .env and fill in. NEVER commit .env.
# Use a NEW wallet that only ever holds testnet ETH. Never your main wallet.
PRIVATE_KEY=0xYOUR_TESTNET_ONLY_PRIVATE_KEY
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: Etherscan API key (v2 keys work for Basescan) to verify contracts
ETHERSCAN_API_KEY=

# Optional deploy settings (defaults shown)
TOKEN_NAME=Launch Kit Demo
TOKEN_SYMBOL=LKD
TOTAL_SUPPLY=1000000000
TEAM_ALLOCATION_BPS=2000
CLIFF_SECONDS=600
VESTING_SECONDS=2592000
# TEAM_BENEFICIARY defaults to the deployer address
TEAM_BENEFICIARY=
